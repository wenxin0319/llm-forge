PORT=3001
# Required — the app refuses to start without this set. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Admin account bootstrap — both required together, or neither. If unset, no
# admin account is created or modified at boot. If set, the account matching
# ADMIN_EMAIL is created (or promoted to admin) and its password hash is
# rotated to match ADMIN_PASSWORD whenever they diverge — so rotating the
# admin password in production is just changing this env var and redeploying.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Database — PostgreSQL
# Railway sets DATABASE_URL automatically when you add the Postgres plugin
# For local development, either set DATABASE_URL or the individual vars below
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/llmforge

# Individual DB vars (used as fallback when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=llmforge

# CORS — Frontend origin
# Local dev: http://localhost:3000
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# GPU telemetry: auto tries nvidia-smi and falls back to labeled demo data;
# real fails closed without nvidia-smi; mock always returns deterministic demo data.
GPU_METRICS_MODE=auto

# Training execution: mock preserves the public demo; local launches only the
# repository's approved Python script on this host (configure a CUDA worker).
TRAINING_EXECUTION_MODE=mock
TRAINING_PYTHON_EXECUTABLE=python3
TRAINING_DATA_ROOT=./uploads
TRAINING_OUTPUT_ROOT=./ml-tools/train/out/jobs

# Artifact storage: unset (or anything other than "s3") keeps artifacts on
# local disk, served through the authenticated /artifacts/:id/download route.
# Set to "s3" to instead upload completed artifacts to real object storage
# and serve downloads as expiring presigned URLs. Works against AWS S3
# unmodified; point ARTIFACT_STORAGE_ENDPOINT at a self-hosted MinIO or
# Cloudflare R2 endpoint and set ARTIFACT_STORAGE_FORCE_PATH_STYLE=true for
# those (verified locally against MinIO — real PutObject/GetObject, real
# presigned-URL round trip, checksum-matched).
ARTIFACT_STORAGE_MODE=local
ARTIFACT_STORAGE_BUCKET=
ARTIFACT_STORAGE_REGION=us-east-1
# Leave unset for real AWS S3; set for MinIO/R2/other S3-compatible hosts
ARTIFACT_STORAGE_ENDPOINT=
ARTIFACT_STORAGE_FORCE_PATH_STYLE=false
# Leave unset to use the default AWS credential chain (IAM role, etc.)
ARTIFACT_STORAGE_ACCESS_KEY_ID=
ARTIFACT_STORAGE_SECRET_ACCESS_KEY=
ARTIFACT_STORAGE_URL_TTL_SECONDS=3600
